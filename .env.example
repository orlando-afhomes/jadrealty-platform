# JAD monorepo — root environment template.
# Per-app variables live in each app's own `.env.example`.
# Secrets are NEVER committed. Only `VITE_`-prefixed vars ship to the client bundle
# (DEVELOPMENT-GUIDELINES §18).

# Supabase Auth seed — Phase 1 (local .env only, never commit)
# SUPABASE_SEED_ADMIN_PASSWORD=your-admin-password  # for admin@jad.local
# SUPABASE_SEED_USER_PASSWORD=your-user-password   # for user@jad.local
# Required for pnpm seed: VITE_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL

# Reverse geolocation — Nominatim (OpenStreetMap) — server-only, never VITE_
# Resolves GPS lat/lon → ISO country for POST /api/v1/registration/location-verify
# Nominatim requires a valid User-Agent per https://operations.osmfoundation.org/policies/nominatim/
# No API key for default OSM endpoint; self-hosted alternative via REVERSE_GEO_PROVIDER_URL
# REVERSE_GEO_PROVIDER_URL=https://nominatim.openstreetmap.org/reverse
# REVERSE_GEO_USER_AGENT=jad-realty/1.0 (contact: support@jad.local)
# REVERSE_GEO_REFERER=https://jad-realty.vercel.app
# REVERSE_GEO_TIMEOUT_MS=4000
