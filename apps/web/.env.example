# JAD public website — environment template.
# Only `VITE_`-prefixed vars are exposed to the client bundle (DEVELOPMENT-GUIDELINES §18).
# Copy to `.env.local` for local overrides. Never commit `.env*` (FOLDER-STRUCTURE §9.4).

# Base URL of the JAD REST API. Same-origin `/api/v1` is the default (API-SPECIFICATION §1.1).
VITE_API_BASE_URL=/api/v1

# Base URL of the Admin application for cross-origin redirects from the web origin.
# Used when the web app needs to redirect staff users to the admin panel.
VITE_ADMIN_URL=http://localhost:5174/admin

# Base URL of the Web (public/member) application for cross-origin redirects from the admin origin.
# Used when the admin app needs to redirect staff users back to the public login.
VITE_WEB_URL=http://localhost:5173

# Supabase — Postgres + Auth + Storage + Realtime (https://supabase.com)
# Get from Supabase Dashboard → Project Settings → API. Keep anon key public (RLS enforced).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never VITE_): Set in root .env (not .env.local) and never commit.
# DATABASE_URL=postgresql://user:password@host:5432/jad
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SEED_ADMIN_PASSWORD=your-admin-password  # for pnpm seed (local only)
# SUPABASE_SEED_USER_PASSWORD=your-user-password   # for pnpm seed (local only)
# Reverse geolocation (server-only) — Nominatim OSM for POST /api/v1/registration/location-verify
# REVERSE_GEO_PROVIDER_URL=https://nominatim.openstreetmap.org/reverse
# REVERSE_GEO_USER_AGENT=jad-realty/1.0 (contact: support@jad.local)
# REVERSE_GEO_REFERER=https://jad-realty.vercel.app
# REVERSE_GEO_TIMEOUT_MS=4000
