# JAD admin panel — environment template.
# Only `VITE_`-prefixed vars are exposed to the client bundle (DEVELOPMENT-GUIDELINES §18).
# Copy to `.env.local` for local overrides. Never commit `.env*` (FOLDER-STRUCTURE §9.4).

# Base URL of the JAD REST API. Same-origin `/api/v1` is the default (API-SPECIFICATION §1.1).
VITE_API_BASE_URL=/api/v1

# Base URL of the Web (public/member) application for cross-origin redirects from the admin origin.
VITE_WEB_URL=http://localhost:5173

# Base URL of the Admin application for cross-origin redirects from the web origin.
VITE_ADMIN_URL=http://localhost:5174/admin

# Supabase — Postgres + Auth + Storage + Realtime
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never VITE_): Set in root .env (not .env.local) and never commit.
# DATABASE_URL=postgresql://user:password@host:5432/jad
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SEED_ADMIN_PASSWORD=your-admin-password  # for pnpm seed (local only)
# SUPABASE_SEED_USER_PASSWORD=your-user-password   # for pnpm seed (local only)